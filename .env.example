# Optional: without a key Mochi runs explicitly labeled extractive demo mode.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Local SQLite; relative paths resolve from your launch directory.
MOCHI_DB_PATH=data/mochi.sqlite3
# Explicit web origins; Chrome/Edge extension origins are also allowed.
MOCHI_CORS_ORIGINS=http://127.0.0.1:8765,http://localhost:8765
