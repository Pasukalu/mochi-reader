# Optional advanced defaults. You can configure the provider in the web UI instead.
# Saved UI settings take precedence over these environment defaults.
# Without a key Mochi runs explicitly labeled extractive demo mode.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Local SQLite; relative paths resolve from your launch directory.
MOCHI_DB_PATH=data/mochi.sqlite3
# Optional override. By default, plaintext provider settings are saved next to
# the database as provider-settings.json. The default data/ folder is gitignored.
# MOCHI_SETTINGS_PATH=data/provider-settings.json
# Explicit web origins; Chrome/Edge extension origins are also allowed.
MOCHI_CORS_ORIGINS=http://127.0.0.1:8765,http://localhost:8765
